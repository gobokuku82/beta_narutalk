# 백엔드 (run_server.py, port 8001)
# ⚠️ localhost 대신 127.0.0.1 사용 — Windows에서 localhost→::1(IPv6) 선해석으로 ~2초 지연되는
#    문제를 코드(src/api/rest.ts·ws.ts)가 127.0.0.1 기본값으로 회피함. localhost 로 되돌리지 말 것.
VITE_BACKEND_URL=http://127.0.0.1:8001
VITE_WS_URL=ws://127.0.0.1:8001

# Feature flags (Sprint 6+)
# VITE_FEATURE_AUTH=false
# VITE_FEATURE_WORKFLOW_TEMPLATES=false
