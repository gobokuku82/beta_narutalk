# DreamAgent 환경 변수
# 이 파일을 .env로 복사하여 사용하세요: cp .env.example .env

# ===========================================
# LLM API Keys (Required)
# ===========================================
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ===========================================
# Database (Required) — PostgreSQL
# ===========================================
# 시스템 DB = dreamagent_system (LangGraph checkpoint + 대화 + memory)
# 데이터 DB = dreamagent_data (schema-per-client) — DATA_DB_URI 미설정 시 CHECKPOINT 자격증명 재사용
CHECKPOINT_DB_URI=postgresql://postgres:your-password@localhost:5432/dreamagent_system
# DATA_DB_URI=postgresql://postgres:your-password@localhost:5432/dreamagent_data
# 데이터 영속화 백엔드: file(기본) | postgres
# DATA_BACKEND=file

# ===========================================
# App / Server
# ===========================================
APP_NAME=DreamAgent
APP_VERSION=2.0.0
DEBUG=true
ENVIRONMENT=development  # development | staging | production
# HOST=0.0.0.0
# PORT=8000

# ===========================================
# Logging
# ===========================================
# LOG_LEVEL=INFO
# LOG_FORMAT=json   # json | text

# ===========================================
# 멀티플렉싱 / 동시성 / 대화 컨텍스트
# ===========================================
DEFAULT_USER_ID=demo
MAX_CONCURRENT_TURNS_PER_USER=3
MAX_WS_CONNECTIONS_PER_USER=5
DEFAULT_HISTORY_LIMIT=3
MAX_HISTORY_LIMIT=10

# ===========================================
# CORS / Layer Guard (Optional)
# ===========================================
# CORS 허용 오리진 — JSON 배열 형식. 배포 시 구체 오리진으로 제한 권장
# CORS_ORIGINS=["*"]
# '유의미 쿼리' 판정 보강 필드(dotted-path 목록, JSON 배열) — 도메인 주입 시 선언
# MEANINGFUL_QUERY_FIELDS=["targets.brand"]

# ===========================================
# HITL resume 타임아웃 (초) — 기본 1800(30분), 1 이상 정수
# ===========================================
# HITL_RESUME_TIMEOUT_SEC=1800

# ===========================================
# LangSmith Monitoring (Optional)
# ===========================================
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=dreamagent
