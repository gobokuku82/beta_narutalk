# Medical Supervisor Environment Variables Example
# 의료/제약 도메인 Supervisor 환경 변수 예시
#
# 이 파일을 복사하여 .env로 만들고 실제 값으로 채워주세요
# cp .env.example .env

# ===========================================
# LLM API Keys
# ===========================================

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=org-your-organization-id  # Optional

# Anthropic API Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ===========================================
# Database Configuration
# ===========================================

# PostgreSQL (Structured DB)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medical_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSL_MODE=prefer  # disable, allow, prefer, require, verify-ca, verify-full

# MongoDB (Unstructured DB)
MONGO_CONNECTION_STRING=mongodb://username:password@localhost:27017/medical_docs
MONGO_DATABASE=medical_docs
MONGO_COLLECTION_PREFIX=med_

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password  # Leave empty if no password
REDIS_DB=0
REDIS_SSL=false

# ===========================================
# External API Keys
# ===========================================

# Naver API (한국어 검색)
NAVER_API_KEY=your_naver_api_key
NAVER_SECRET_KEY=your_naver_secret_key

# Google API (글로벌 검색)
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CUSTOM_SEARCH_ID=your_custom_search_engine_id

# 건강보험심사평가원 (HIRA) API
HIRA_SERVICE_KEY=your_hira_service_key
HIRA_API_VERSION=v1

# PubMed API (의학 논문)
PUBMED_API_KEY=your_pubmed_api_key  # Optional, but recommended for higher rate limits

# ===========================================
# FastAPI Server Configuration
# ===========================================

# FastAPI Server (Text2SQL Service)
FASTAPI_BASE_URL=http://localhost:8000
FASTAPI_API_KEY=your_internal_api_key  # For internal service authentication

# ===========================================
# Security & Authentication
# ===========================================

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440  # 24 hours

# Encryption
ENCRYPTION_KEY=your-32-byte-encryption-key-for-aes256
ENCRYPTION_ALGORITHM=AES-256-GCM

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ===========================================
# Application Settings
# ===========================================

# Environment
ENVIRONMENT=development  # development, staging, production
DEBUG_MODE=false
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Paths
LOG_PATH=./logs
CHECKPOINT_PATH=./checkpoints
CHROMA_PERSIST_PATH=./chroma_db
UPLOAD_PATH=./uploads

# Server Configuration
HOST=0.0.0.0
PORT=8080
WORKERS=4
RELOAD=false  # Set to true in development

# ===========================================
# LangGraph Configuration
# ===========================================

# LangGraph Settings
LANGGRAPH_VERSION=0.6.7
LANGGRAPH_SUPERVISOR_VERSION=0.0.29
LANGGRAPH_CHECKPOINT_TYPE=sqlite
LANGGRAPH_STORE_TYPE=memory

# Execution Settings
MAX_PARALLEL_TASKS=3
DEFAULT_TIMEOUT_SECONDS=60
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2.0
RETRY_BACKOFF_FACTOR=1.5

# ===========================================
# Medical Domain Specific
# ===========================================

# Compliance Settings
DEFAULT_COMPLIANCE_LEVEL=strict  # strict, normal, relaxed
ENABLE_REGULATION_CHECK=true
AUTO_COMPLIANCE_VALIDATION=true

# Medical Data Sources
ENABLE_HIRA_INTEGRATION=true
ENABLE_PUBMED_SEARCH=true
ENABLE_CLINICAL_TRIALS=false

# ===========================================
# Monitoring & Observability
# ===========================================

# Prometheus Metrics
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Tracing (OpenTelemetry)
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=medical-supervisor

# LangSmith (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=medical-supervisor
LANGCHAIN_API_KEY=your_langsmith_api_key

# ===========================================
# Performance Tuning
# ===========================================

# Cache Settings
CACHE_ENABLED=true
CACHE_TTL_DEFAULT=600  # 10 minutes in seconds
CACHE_MAX_SIZE=1000

# Thread Pool
THREAD_POOL_SIZE=10
CONNECTION_POOL_SIZE=20

# Batch Processing
BATCH_SIZE=100
PREFETCH_COUNT=10

# ===========================================
# Development & Testing
# ===========================================

# Test Configuration
TEST_MODE=false
MOCK_EXTERNAL_APIS=false
USE_TEST_DATABASE=false

# Development Tools
HOT_RELOAD=false
VERBOSE_LOGGING=false
SAVE_QUERY_HISTORY=true

# ===========================================
# Feature Flags
# ===========================================

# Feature Toggles
ENABLE_CACHING=true
ENABLE_PARALLEL_EXECUTION=true
ENABLE_LAZY_LOADING=true
ENABLE_QUERY_OPTIMIZATION=true
ENABLE_AUTO_RETRY=true
ENABLE_CONTEXT_OPTIMIZATION=true

# ===========================================
# Additional Notes
# ===========================================

# 1. Security: Never commit the actual .env file to version control
# 2. Backup: Keep secure backups of production environment variables
# 3. Rotation: Regularly rotate sensitive keys and passwords
# 4. Monitoring: Monitor API usage to avoid rate limits
# 5. Documentation: Document any custom environment variables

# End of .env.example