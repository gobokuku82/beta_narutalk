# ADALLPIN 환경 변수 설정
# 이 파일을 .env로 복사하여 사용하세요: cp .env.example .env

# ===========================================
# LLM API Keys (Required)
# ===========================================
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ===========================================
# Frontend Configuration (Next.js)
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ===========================================
# Database Configuration (Required)
# ===========================================
# PostgreSQL 형식: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# 시스템 DB = octormate_system (LangGraph checkpoint + 대화) / 데이터 DB = octormate_data (client 정형)
DATABASE_URL=postgresql+psycopg://postgres:your-password@localhost:5432/octormate_system
# Checkpoint DB (LangGraph AsyncPostgresSaver) — 시스템 DB
CHECKPOINT_DB_URI=postgresql://postgres:your-password@localhost:5432/octormate_system
# 또는 SQLite 사용시
# DATABASE_URL=sqlite:///./octormate_system.db

# ===========================================
# FastAPI Configuration
# ===========================================
APP_NAME=ADALLPIN
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development  # development | production
# SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# CORS Settings
# ===========================================
# BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# ===========================================
# Redis Configuration (Optional - for caching)
# ===========================================
# REDIS_URL=redis://localhost:6379/0

# ===========================================
# Logging
# ===========================================
# LOG_LEVEL=INFO
# LOG_FILE=./logs/app.log

# ===========================================
# Model Configuration
# ===========================================
# DEFAULT_MODEL_NAME=gpt-4
# DEFAULT_EMBEDDING_MODEL=text-embedding-ada-002
# MAX_TOKENS=2000
# TEMPERATURE=0.7

# ===========================================
# Rate Limiting
# ===========================================
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_PERIOD=3600

# ===========================================
# File Upload
# ===========================================
# MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
# ALLOWED_EXTENSIONS=["pdf", "txt", "docx", "md"]

# ===========================================
# External Services
# ===========================================
# PUBLIC_DATA_API_KEY=your-public-data-api-key-here

# ===========================================
# AI Insight Agent - Data Collection APIs
# ===========================================
# 완전 무료 데이터 수집 전략 (K-Beauty 글로벌 마켓 분석용)

# ----- News Data (뉴스 수집) -----
# DuckDuckGo Search: 메인 뉴스/검색 도구 (무제한, API 키 불필요)
# → 별도 설정 필요 없음, duckduckgo-search 라이브러리 사용

# Google Custom Search Engine (https://programmablesearchengine.google.com/)
# 무료: 100 requests/day = ~3,000/month
# 상세 설정: https://developers.google.com/custom-search/v1/overview
# GOOGLE_CSE_API_KEY=your-google-cse-api-key-here
# GOOGLE_CSE_CX=your-custom-search-engine-id-here

# ----- Shopping Data (쇼핑 데이터) -----
# SerpAPI - Amazon/Google Shopping 전용 (https://serpapi.com/)
# 무료: 100 searches/month (자동 저장 및 재사용 시스템 적용)
# API 할당량 소진 시 캐시된 데이터 자동 사용
# SERPAPI_KEY=your-serpapi-key-here

# ----- Development Mode (개발 모드) -----
# Mock 데이터 사용으로 API 호출 최소화
# true 설정 시 data/mock_data/ 디렉토리의 샘플 데이터 사용
USE_MOCK_DATA=false

# ===========================================
# Agent Configuration
# ===========================================
# AGENT_MAX_ITERATIONS=10
# AGENT_TIMEOUT_SECONDS=300
# ENABLE_HUMAN_IN_LOOP=true

# ===========================================
# Memory Configuration
# ===========================================
# MEMORY_TYPE=sqlite  # Options: sqlite, postgres, redis
# MEMORY_WINDOW_SIZE=10
# ENABLE_LONG_TERM_MEMORY=true

# ===========================================
# RunPod (이미지 생성)
# ===========================================
# RUNPOD_API_KEY=your-runpod-api-key
# RUNPOD_ENDPOINT_ID=your-endpoint-id

# ===========================================
# LangSmith Monitoring (Optional)
# ===========================================
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=adallpin
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ===========================================
# Sprint 13 — 멀티플렉싱 / 동시성 / 대화 컨텍스트
# ===========================================
# 사용자 식별 (Sprint 16+ 실제 로그인 전까지 "demo" 고정)
DEFAULT_USER_ID=demo

# 유저당 동시 실행 쿼리 상한 (ConcurrencyManager)
MAX_CONCURRENT_TURNS_PER_USER=3

# 유저당 WebSocket 연결 상한 (탭 다중 지원)
MAX_WS_CONNECTIONS_PER_USER=5

# Cognitive에 주입할 과거 대화 개수 (기본/상한)
DEFAULT_HISTORY_LIMIT=3
MAX_HISTORY_LIMIT=10

# 대화 제목 자동 생성 (Sprint 15 실사용)
TITLE_SOURCE=first_query          # first_query | summary_llm
TITLE_MAX_LENGTH=15
# ===========================================
# Sprint 14 A1 — HITL resume 타임아웃 (초)
# ===========================================
# 기본값: 1800 (30분, NFR-9). 생략 시 자동 적용.
# 1 이상 정수만 허용 (pydantic Field(ge=1) validator).
# HITL_RESUME_TIMEOUT_SEC=1800
#
# 테스트 용도로 낮출 때 (live 테스트 / 브라우저 R-13/R-14/R-15):
#   HITL_RESUME_TIMEOUT_SEC=10
#   → 서버 재기동 후 검증 완료되면 주석 처리 또는 1800 원복.
# 관련 테스트:
#   uv run pytest backend/tests/sprint14/test_hitl_timeout_e2e_live.py::test_HTL01_... -m live