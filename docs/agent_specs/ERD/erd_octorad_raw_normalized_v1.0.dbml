}

// ─── 매칭 Ref: raw 컬럼 > canonical (이름 변경 연결) ───
Ref: meta_ads_performance."data[].spend" > normalized_measures.ad_cost_krw
Ref: naver_searchad."data[].salesAmt" > normalized_measures.ad_cost_krw
Ref: naver_advoost.cost > normalized_measures.ad_cost_krw
Ref: meta_ads_performance."data[].impressions" > normalized_measures.impressions
Ref: naver_searchad."data[].impCnt" > normalized_measures.impressions
Ref: naver_advoost.impressions > normalized_measures.impressions
Ref: meta_ads_performance."data[].clicks" > normalized_measures.clicks
Ref: naver_searchad."data[].clkCnt" > normalized_measures.clicks
Ref: naver_advoost.clicks > normalized_measures.clicks
Ref: meta_ads_performance."data[].inline_link_clicks" > normalized_measures.link_clicks
Ref: meta_ads_performance."data[].actions[].value" > normalized_measures.conversion_count
Ref: naver_searchad."data[].ccnt" > normalized_measures.conversion_count
Ref: naver_advoost.click_through_conversions > normalized_measures.conversion_count
Ref: naver_advoost.view_through_conversions > normalized_measures.vt_conversion_count
Ref: meta_ads_performance."data[].action_values[].value" > normalized_measures.conversion_revenue_krw
Ref: naver_searchad."data[].convAmt" > normalized_measures.conversion_revenue_krw
Ref: naver_advoost.conversion_value > normalized_measures.conversion_revenue_krw
Ref: meta_ads_performance."data[].reach" > normalized_measures.paid_reach
Ref: meta_ads_performance."data[].frequency" > normalized_measures.impression_frequency
Ref: kakao_bizmessage."campaigns[].summary.total_cost_krw" > normalized_measures.msg_cost_krw
Ref: naver_talktalk."campaigns[].summary.total_cost_krw" > normalized_measures.msg_cost_krw
Ref: kakao_bizmessage."campaigns[].summary.target_recipients" > normalized_measures.msg_target_count
Ref: naver_talktalk."campaigns[].summary.target_friends" > normalized_measures.msg_target_count
Ref: crm_send_logs.target_count > normalized_measures.msg_target_count
Ref: kakao_bizmessage."campaigns[].summary.open_count" > normalized_measures.msg_open_count
Ref: naver_talktalk."campaigns[].summary.open_count" > normalized_measures.msg_open_count
Ref: crm_send_logs.open_count > normalized_measures.msg_open_count
Ref: naver_interest_alert.message_open_count > normalized_measures.msg_open_count
Ref: kakao_bizmessage."campaigns[].summary.click_count" > normalized_measures.msg_click_count
Ref: naver_talktalk."campaigns[].summary.click_count" > normalized_measures.msg_click_count
Ref: crm_send_logs.click_count > normalized_measures.msg_click_count
Ref: naver_interest_alert.message_click_count > normalized_measures.msg_click_count
Ref: kakao_bizmessage."campaigns[].summary.conversion_count" > normalized_measures.msg_conversion_count
Ref: naver_talktalk."campaigns[].summary.conversion_count" > normalized_measures.msg_conversion_count
Ref: naver_interest_alert.conversion_count > normalized_measures.msg_conversion_count
Ref: kakao_bizmessage."campaigns[].summary.conversion_amount_krw" > normalized_measures.msg_conversion_revenue_krw
Ref: naver_talktalk."campaigns[].summary.conversion_amount_krw" > normalized_measures.msg_conversion_revenue_krw
Ref: crm_send_logs.conversion_amount_krw > normalized_measures.msg_conversion_revenue_krw
Ref: naver_interest_alert.conversion_amount > normalized_measures.msg_conversion_revenue_krw
Ref: orders.payment_amount > normalized_measures.order_revenue_krw
