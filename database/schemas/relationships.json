      "primary": {
        "database": "hr_data",
        "table": "인사자료",
        "column": "사번"
      },
      "foreign": {
        "database": "sales_performance_db",
        "table": "sales_performance",
        "column": "사번"
      },
      "join_condition": "인사자료.사번 = sales_performance.사번",
      "use_cases": [
        "직원별 판매 실적 조회",
