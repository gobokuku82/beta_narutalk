{
  "databases": {
    "hr_data": {
      "name": "HR 데이터베이스",
      "description": "인사 관리 시스템 데이터베이스",
      "tables": {
        "인사자료": {
          "description": "전체 직원의 인사 정보를 관리하는 핵심 테이블",
          "business_context": "직원의 기본 정보, 소속, 급여, 평가 등을 종합적으로 관리",
          "columns": {
            "사번": {
              "description": "직원 고유 식별 번호",
              "format": "예: E001, E002",
              "usage": "직원 검색 및 다른 테이블과의 조인 키"
            },
            "성명": {
              "description": "직원 이름",
              "format": "한글 실명",
              "usage": "직원 검색 시 주로 사용"
            },
            "본부": {
              "description": "소속 본부",
              "format": "예: 영업본부, 경영지원본부",
              "usage": "조직별 분석 시 사용"
            },
            "직급": {
              "description": "직원의 직급",
              "format": "사원, 대리, 과장, 차장, 부장 등",
              "usage": "직급별 통계 및 권한 관리"
            },
            "부서": {
              "description": "소속 부서",
              "format": "예: 영업1팀, 마케팅팀",
              "usage": "부서별 실적 분석"
            },
            "지점": {
              "description": "근무 지점",
              "format": "지역명 + 지점",
              "usage": "지점별 인원 및 실적 관리"
            },
            "연락처": {
              "description": "직원 연락처",
              "format": "010-XXXX-XXXX",
              "usage": "비상 연락 및 업무 연락"
            },
            "월평균사용예산": {
              "description": "월 평균 사용 예산",
              "format": "숫자 (단위: 원)",
              "usage": "예산 집행 현황 파악"
            },
            "최근 평가": {
              "description": "최근 인사 평가 결과",
              "format": "S, A, B, C 등급",
              "usage": "성과 관리 및 승진 심사"
            },
            "기본급(₩)": {
              "description": "월 기본 급여",
              "format": "숫자 (단위: 원)",
              "usage": "급여 관리 및 인건비 분석"
            },
            "성과급(₩)": {
              "description": "성과 기반 급여",
              "format": "숫자 (단위: 원)",
              "usage": "성과 보상 관리"
            },
            "책임업무": {
              "description": "주요 담당 업무",
              "format": "텍스트 설명",
              "usage": "업무 분장 및 역할 파악"
            }
          }
        },
        "지점연락처": {
          "description": "각 지점의 연락처 정보 관리",
          "business_context": "지점별 공식 연락처 관리 및 조직도 연계",
          "columns": {
            "본부": {
              "description": "지점이 속한 본부",
              "format": "본부명",
              "usage": "조직 체계 파악"
            },
            "부서": {
              "description": "지점이 속한 부서",
              "format": "부서명",
              "usage": "부서별 지점 관리"
            },
            "지점": {
              "description": "지점명",
              "format": "지역 + 지점",
              "usage": "지점 식별"
            },
            "지점 연락처": {
              "description": "지점 대표 전화번호",
              "format": "02-XXXX-XXXX",
              "usage": "공식 업무 연락"
            }
          }
        }
      }
    },
    "sales": {
      "name": "영업 실적 데이터베이스 그룹",
      "description": "영업 활동 및 실적 관련 데이터베이스 모음",
      "databases": {
        "clients_db": {
          "name": "거래처 실적 데이터베이스",
          "tables": {
            "거래처자료": {
              "description": "거래처별 월간 영업 실적 데이터",
              "business_context": "거래처별 매출, 방문, 예산 사용 현황을 월 단위로 추적",
              "columns": {
                "거래처ID": {
                  "description": "거래처 고유 식별자",
                  "format": "예: C001, H001",
                  "usage": "거래처 구분 및 조인 키"
                },
                "월": {
                  "description": "데이터 기준월",
                  "format": "YYYYMM (예: 202401)",
                  "usage": "시계열 분석"
                },
                "매출": {
                  "description": "월 매출액",
                  "format": "숫자 (단위: 원)",
                  "usage": "매출 분석 및 목표 대비 실적"
                },
                "월방문횟수": {
                  "description": "월간 방문 횟수",
                  "format": "숫자",
                  "usage": "영업 활동 빈도 분석"
                },
                "사용 예산": {
                  "description": "월간 사용 예산",
                  "format": "숫자 (단위: 원)",
                  "usage": "예산 집행 현황"
                },
                "총환자수": {
                  "description": "월간 총 환자 수",
                  "format": "숫자",
                  "usage": "거래처 규모 파악"
                },
                "담당자": {
                  "description": "담당 영업 직원",
                  "format": "직원명",
                  "usage": "담당자별 실적 관리"
                }
              }
            }
          }
        },
        "clients_info": {
          "name": "거래처 정보 데이터베이스",
          "tables": {
            "거래처정보": {
              "description": "거래처 기본 정보 마스터 테이블",
              "business_context": "병원 및 의료기관 거래처의 기본 정보 관리",
              "columns": {
                "ID": {
                  "description": "거래처 고유 ID",
                  "format": "예: C001, H001",
                  "usage": "Primary Key, 다른 테이블과 조인"
                },
                "원장명": {
                  "description": "병원장/원장 이름",
                  "format": "한글 실명",
                  "usage": "거래처 담당자 파악"
                },
                "지역구": {
                  "description": "거래처 소재 지역",
                  "format": "시/구 단위",
                  "usage": "지역별 영업 전략"
                },
                "병원연락처": {
                  "description": "병원 대표 전화번호",
                  "format": "02-XXXX-XXXX",
                  "usage": "업무 연락"
                }
              }
            }
          }
        },
        "sales_performance": {
          "name": "판매 실적 데이터베이스",
          "tables": {
            "sales_performance": {
              "description": "직원별 거래처별 품목별 월간 판매 실적",
              "business_context": "개인별 상세 판매 실적을 월 단위로 추적 (2022.12 ~ 2024.11)",
              "columns": {
                "사번": {
                  "description": "직원 사번",
                  "format": "예: E001",
                  "usage": "인사자료 테이블과 조인"
                },
                "담당자": {
                  "description": "담당 직원명",
                  "format": "한글 실명",
                  "usage": "직원별 실적 조회"
                },
                "거래처ID": {
                  "description": "거래처 고유 ID",
                  "format": "예: C001",
                  "usage": "거래처정보 테이블과 조인"
                },
                "품목": {
                  "description": "판매 제품/품목",
                  "format": "제품명",
                  "usage": "품목별 판매 분석"
                },
                "202212~202411": {
                  "description": "각 월별 판매 실적",
                  "format": "숫자 (단위: 원)",
                  "usage": "월별 실적 추이 분석"
                }
              }
            }
          }
        },
        "sales_target": {
          "name": "판매 목표 데이터베이스",
          "tables": {
            "지점별목표": {
              "description": "지점별 월간 판매 목표 설정",
              "business_context": "지점 단위의 월별 목표 관리 (2023.12 ~ 2024.11)",
              "columns": {
                "지점": {
                  "description": "지점명",
                  "format": "지역 + 지점",
                  "usage": "지점별 목표 관리"
                },
                "담당자": {
                  "description": "지점 담당자",
                  "format": "직원명",
                  "usage": "책임자 파악"
                },
                "202312~202411": {
                  "description": "각 월별 판매 목표",
                  "format": "숫자 (단위: 원)",
                  "usage": "목표 대비 실적 분석"
                }
              }
            }
          }
        }
      }
    }
  },
  "common_queries": {
    "인사_관련": [
      "특정 직원의 정보 조회",
      "부서별 인원 현황",
      "직급별 급여 통계",
      "지점별 인원 배치 현황"
