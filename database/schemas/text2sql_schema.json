{
  "version": "1.0",
  "description": "좋은제약 데이터베이스 스키마 - Text2SQL용",
  "databases": {
    "hr_data": {
      "file_path": "database/hr_information/hr_data.db",
      "description": "인사 관리 및 고객 연락처 정보를 담은 데이터베이스",
      "tables": {
        "employee_info": {
          "original_name": "인사자료",
          "description": "직원 정보 관리 테이블 (80명)",
          "primary_key": null,
          "columns": {
            "name": {
              "original_name": "성명",
              "type": "TEXT",
              "description": "직원 이름",
              "nullable": true,
              "example": "홍길동"
            },
            "position": {
              "original_name": "직위",
              "type": "TEXT",
              "description": "직위 (대표, 이사, 부장, 차장, 과장, 대리, 사원)",
              "nullable": true,
              "example": "과장"
            },
            "rank": {
              "original_name": "직급",
              "type": "TEXT",
              "description": "직급 구분",
              "nullable": true,
              "example": "관리직"
            },
            "department": {
              "original_name": "부서",
              "type": "TEXT",
              "description": "소속 부서 (영업부, 마케팅부, 경영지원부 등)",
              "nullable": true,
              "example": "영업1팀"
            },
            "birth_date": {
              "original_name": "생일",
              "type": "TEXT",
              "description": "생년월일",
              "nullable": true,
              "example": "1985-03-15"
            },
            "contact": {
              "original_name": "연락처",
              "type": "TEXT",
              "description": "휴대폰 번호",
              "nullable": true,
              "example": "010-1234-5678"
            },
            "vacation_remaining": {
              "original_name": "휴가잔여예상",
              "type": "REAL",
              "description": "잔여 휴가 일수",
              "nullable": true,
              "example": 15.5
            },
            "recent_vacation": {
              "original_name": "최근연차",
              "type": "TEXT",
              "description": "최근 연차 사용일",
              "nullable": true,
              "example": "2024-10-15"
            }
          },
          "common_queries": [
            "특정 부서의 직원 목록 조회",
            "직위별 인원 수 집계",
            "휴가 잔여일이 많은 직원 조회"
          ]
        },
        "customer_contacts": {
          "original_name": "고객연락처",
          "description": "주요 고객 연락처 정보 (14명)",
          "primary_key": null,
          "columns": {
            "name": {
              "original_name": "성명",
              "type": "TEXT",
              "description": "고객 이름",
              "nullable": true
            },
            "organization": {
              "original_name": "소속",
              "type": "TEXT",
              "description": "소속 기관/병원",
              "nullable": true
            },
            "position": {
              "original_name": "직위",
              "type": "TEXT",
              "description": "직위/직책",
              "nullable": true
            },
            "contact": {
              "original_name": "연락처",
              "type": "TEXT",
              "description": "연락처",
              "nullable": true
            }
          }
        }
      }
    },
    "sales_performance": {
      "file_path": "database/sales_performance_db/sales_performance_db.db",
      "description": "월별 영업 실적 데이터 (2022년 12월 ~ 2024년 11월)",
      "tables": {
        "sales_performance": {
          "original_name": "sales_performance",
          "description": "제품별, 거래처별 월별 판매 실적 (1,711개 레코드)",
          "primary_key": null,
          "columns": {
            "team": {
              "original_name": "팀명",
              "type": "TEXT",
              "description": "영업팀 구분 (영업1팀, 영업2팀 등)",
              "nullable": true,
              "example": "영업1팀"
            },
            "sales_person": {
              "original_name": "담당자",
              "type": "TEXT",
              "description": "영업 담당자 이름",
              "nullable": true,
              "example": "김영업"
            },
            "client_id": {
              "original_name": "거래처ID",
              "type": "TEXT",
              "description": "거래처 고유 식별자",
              "nullable": true,
              "example": "C001234",
              "foreign_key": "clients.거래처ID"
            },
            "product": {
              "original_name": "품목",
              "type": "TEXT",
              "description": "판매 제품명",
              "nullable": true,
              "example": "아스피린정"
            },
            "monthly_sales": {
              "pattern": "YYYYMM",
              "columns": ["202212", "202301", "202302", "202303", "202304", "202305", "202306", "202307", "202308", "202309", "202310", "202311", "202312", "202401", "202402", "202403", "202404", "202405", "202406", "202407", "202408", "202409", "202410", "202411"],
              "type": "INTEGER",
              "description": "월별 판매액 (단위: 원). 컬럼명이 년월(YYYYMM) 형식",
              "nullable": true,
              "example": "202410 컬럼 = 2024년 10월 판매액"
            }
          },
          "common_queries": [
            "특정 담당자의 월별 실적 조회",
            "제품별 총 판매액 집계",
            "특정 기간의 팀별 실적 비교",
            "전년 동월 대비 성장률 계산"
          ],
          "notes": "월별 데이터는 개별 컬럼으로 저장됨. 시계열 분석 시 UNPIVOT 필요"
        }
      }
    },
    "clients": {
      "file_path": "database/sales_performance_db/clients_db.db",
      "description": "거래처 방문 및 관리 정보",
      "tables": {
        "client_data": {
          "original_name": "거래처자료",
          "description": "거래처별 상세 방문 및 관리 정보 (6,912개 레코드)",
          "primary_key": null,
          "columns": {
            "client_id": {
              "original_name": "거래처ID",
              "type": "TEXT",
              "description": "거래처 고유 식별자",
              "nullable": true,
              "example": "C001234"
            },
            "department": {
              "original_name": "과",
              "type": "INTEGER",
              "description": "진료과 코드",
              "nullable": true
            },
            "ward": {
              "original_name": "병동",
              "type": "INTEGER",
              "description": "병동 번호",
              "nullable": true
            },
            "monthly_visits": {
              "original_name": "월별방문횟수",
              "type": "INTEGER",
              "description": "월 평균 방문 횟수",
              "nullable": true,
              "example": 4
            },
            "doctor_in_charge": {
              "original_name": "담당의사",
              "type": "INTEGER",
              "description": "담당 의사 수",
              "nullable": true
            },
            "patient_count": {
              "original_name": "환자수",
              "type": "INTEGER",
              "description": "관리 환자 수",
              "nullable": true
            },
            "admin_contact": {
              "original_name": "원무담당",
              "type": "TEXT",
              "description": "원무 담당자 정보",
              "nullable": true
            }
          },
          "common_queries": [
            "방문 횟수가 많은 거래처 조회",
            "병동별 거래처 분포",
            "환자 수 기준 주요 거래처 리스트"
          ]
        }
      }
    },
    "clients_info": {
      "file_path": "database/sales_performance_db/clients_info.db",
      "description": "거래처 기본 정보",
      "tables": {
        "client_info": {
          "original_name": "거래처정보",
          "description": "병원 및 거래처 기본 정보 (288개 레코드)",
          "primary_key": null,
          "columns": {
            "id": {
              "original_name": "ID",
              "type": "TEXT",
              "description": "거래처 ID",
              "nullable": true
            },
            "hospital_name": {
              "original_name": "병원명",
              "type": "TEXT",
              "description": "병원/기관 이름",
              "nullable": true,
              "example": "서울대병원"
            },
            "medical_department": {
              "original_name": "진료과목",
              "type": "TEXT",
              "description": "주요 진료 과목",
              "nullable": true,
              "example": "내과, 정형외과"
            },
            "customer_contact": {
              "original_name": "고객연락처",
              "type": "TEXT",
              "description": "담당자 연락처",
              "nullable": true
            }
          }
        }
      }
    },
    "sales_target": {
      "file_path": "database/sales_performance_db/sales_target_db.db",
      "description": "영업 목표 관리 데이터베이스",
      "tables": {
        "sales_target": {
          "original_name": "영업실적목표",
          "description": "팀별, 담당자별 월별 영업 목표 (6개 레코드)",
          "primary_key": null,
          "columns": {
            "team": {
              "original_name": "팀명",
              "type": "TEXT",
              "description": "영업팀 구분",
              "nullable": true,
              "example": "영업1팀"
            },
            "sales_person": {
              "original_name": "담당자",
              "type": "TEXT",
              "description": "영업 담당자 이름",
              "nullable": true,
              "example": "김영업"
            },
            "monthly_targets": {
              "pattern": "YYYYMM",
              "columns": ["202312", "202401", "202402", "202403", "202404", "202405", "202406", "202407", "202408", "202409", "202410", "202411"],
              "type": "INTEGER",
              "description": "월별 영업 목표액 (단위: 원)",
              "nullable": true,
              "example": "202410 = 2024년 10월 목표"
            }
          },
          "common_queries": [
            "특정 담당자의 목표 달성률 계산",
            "팀별 목표 대비 실적 비교",
            "월별 목표 추이 분석"
          ]
        }
      }
    }
  },
  "relationships": [
    {
      "type": "reference",
      "from": "sales_performance.sales_performance.거래처ID",
      "to": "clients.client_data.거래처ID",
      "description": "영업 실적과 거래처 정보 연결"
    },
    {
      "type": "reference",
      "from": "clients.client_data.거래처ID",
      "to": "clients_info.client_info.ID",
      "description": "거래처 상세 정보와 기본 정보 연결"
    },
    {
      "type": "match",
      "from": "sales_performance.sales_performance.담당자",
      "to": "hr_data.employee_info.성명",
      "description": "영업 담당자와 직원 정보 연결"
    },
    {
      "type": "match",
      "from": "sales_target.sales_target.담당자",
      "to": "sales_performance.sales_performance.담당자",
      "description": "영업 목표와 실적 담당자 매칭"
    }
  ],
  "query_guidelines": {
    "encoding": "UTF-8",
    "column_names": "한글 컬럼명 그대로 사용 (따옴표로 감싸기)",
    "date_format": "월별 데이터는 YYYYMM 형식의 컬럼명",
    "aggregations": "SUM, AVG, COUNT 등 집계 함수 활용 가능",
    "joins": "거래처ID를 통한 테이블 조인 가능"
  },
  "limitations": [
    "월별 데이터가 개별 컬럼으로 저장되어 있어 동적 쿼리 생성 시 주의 필요",
    "한글 컬럼명 사용으로 인한 인코딩 이슈 가능성",
    "Primary Key가 명시적으로 정의되지 않음"
  ]
}